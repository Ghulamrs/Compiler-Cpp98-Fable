// __iterator - cppparse's C++98 library: the iterator categories, iterator_traits, reverse_iterator, advance and
// distance (24.3, 24.4.1), the part of <iterator> the containers need without the streams; and __range_category and
// __range_kind, by which the containers' member templates over two arguments of one type tell a count and a value from
// a range, and a range they can measure from one they can only read (23.1.1/9).
#ifndef CPPPARSE_ITERATOR_BASE
#define CPPPARSE_ITERATOR_BASE

#include <cstddef>
#include <__traits>

namespace std {

struct input_iterator_tag {};
struct output_iterator_tag {};
struct forward_iterator_tag : public input_iterator_tag {};
struct bidirectional_iterator_tag : public forward_iterator_tag {};
struct random_access_iterator_tag : public bidirectional_iterator_tag {};

template <class Category, class T, class Distance = ptrdiff_t, class Pointer = T*, class Reference = T&>
struct iterator {
    typedef Category  iterator_category;
    typedef T         value_type;
    typedef Distance  difference_type;
    typedef Pointer   pointer;
    typedef Reference reference;
};

template <class It>
struct iterator_traits {
    typedef typename It::iterator_category iterator_category;
    typedef typename It::value_type        value_type;
    typedef typename It::difference_type   difference_type;
    typedef typename It::pointer           pointer;
    typedef typename It::reference         reference;
};

// const T* first: cppparse takes the first partial specialisation that matches, not the most specialised one
template <class T>
struct iterator_traits<const T*> {
    typedef random_access_iterator_tag iterator_category;
    typedef T         value_type;
    typedef ptrdiff_t difference_type;
    typedef const T*  pointer;
    typedef const T&  reference;
};

template <class T>
struct iterator_traits<T*> {
    typedef random_access_iterator_tag iterator_category;
    typedef T         value_type;
    typedef ptrdiff_t difference_type;
    typedef T*        pointer;
    typedef T&        reference;
};

// advance and distance: a random access iterator moves in one step, the others step by step
template <class It, class D>
void __advance(It& it, D n, input_iterator_tag) { while (n > 0) { ++it; --n; } }
template <class It, class D>
void __advance(It& it, D n, bidirectional_iterator_tag) { if (n >= 0) { while (n > 0) { ++it; --n; } } else { while (n < 0) { --it; ++n; } } }
template <class It, class D>
void __advance(It& it, D n, random_access_iterator_tag) { it += n; }
template <class It, class D>
void advance(It& it, D n) { __advance(it, n, typename iterator_traits<It>::iterator_category()); }

template <class It>
typename iterator_traits<It>::difference_type __distance(It first, It last, input_iterator_tag)
{
    typename iterator_traits<It>::difference_type n = 0;
    for (; first != last; ++first) ++n;
    return n;
}
template <class It>
typename iterator_traits<It>::difference_type __distance(It first, It last, random_access_iterator_tag) { return last - first; }
template <class It>
typename iterator_traits<It>::difference_type distance(It first, It last) { return __distance(first, last, typename iterator_traits<It>::iterator_category()); }

// What the two arguments (first, last) of a container's member template are, as a type to overload on; the members
// pass a null pointer of that type to their workers, so that no object is made for the choice (23.1.1/9:
// "template <class InputIterator> X(InputIterator, InputIterator)" and the assign and insert of that form):
//   __true_type                 InputIterator is an integral type: a count and a value, as if the count form were called
//   the iterator's category     a range: one that is at least forward is measured with distance and its elements are
//                               placed in one step, an input range is read element by element
// __range_kind<It, T> is __pointer_range_tag besides when It is T* or const T*, the iterators of vector<T> and of
// basic_string<T>: those containers copy such a range as they did before the members were templates (memcpy for the
// bytewise types).
struct __pointer_range_tag {};

template <class It, class Integer> struct __range_category2 { typedef typename iterator_traits<It>::iterator_category type; };
template <class It> struct __range_category2<It, __true_type> { typedef __true_type type; };
template <class It> struct __range_category { typedef typename __range_category2<It, typename __is_integer<It>::type>::type type; };

template <class It, class T> struct __range_kind { typedef typename __range_category<It>::type type; };
template <class T> struct __range_kind<T*, T> { typedef __pointer_range_tag type; };
template <class T> struct __range_kind<const T*, T> { typedef __pointer_range_tag type; };

template <class It>
class reverse_iterator {
public:
    typedef It                                                  iterator_type;
    typedef typename iterator_traits<It>::iterator_category     iterator_category;
    typedef typename iterator_traits<It>::value_type            value_type;
    typedef typename iterator_traits<It>::difference_type       difference_type;
    typedef typename iterator_traits<It>::pointer               pointer;
    typedef typename iterator_traits<It>::reference             reference;

    reverse_iterator() : m_cur() {}
    explicit reverse_iterator(It x) : m_cur(x) {}
    reverse_iterator(const reverse_iterator& o) : m_cur(o.m_cur) {}
    template <class U> reverse_iterator(const reverse_iterator<U>& o) : m_cur(o.base()) {}
    It base() const { return m_cur; }
    reference operator*() const { It tmp = m_cur; --tmp; return *tmp; }
    pointer   operator->() const { It tmp = m_cur; --tmp; return &*tmp; }
    reverse_iterator& operator++() { --m_cur; return *this; }
    reverse_iterator  operator++(int) { reverse_iterator t(*this); --m_cur; return t; }
    reverse_iterator& operator--() { ++m_cur; return *this; }
    reverse_iterator  operator--(int) { reverse_iterator t(*this); ++m_cur; return t; }
    reverse_iterator  operator+(difference_type n) const { return reverse_iterator(m_cur - n); }
    reverse_iterator& operator+=(difference_type n) { m_cur -= n; return *this; }
    reverse_iterator  operator-(difference_type n) const { return reverse_iterator(m_cur + n); }
    reverse_iterator& operator-=(difference_type n) { m_cur += n; return *this; }
    reference operator[](difference_type n) const { return *(*this + n); }
private:
    It m_cur;
};

template <class It> bool operator==(const reverse_iterator<It>& a, const reverse_iterator<It>& b) { return a.base() == b.base(); }
template <class It> bool operator!=(const reverse_iterator<It>& a, const reverse_iterator<It>& b) { return !(a.base() == b.base()); }
template <class It> bool operator<(const reverse_iterator<It>& a, const reverse_iterator<It>& b) { return b.base() < a.base(); }
template <class It> bool operator>(const reverse_iterator<It>& a, const reverse_iterator<It>& b) { return b < a; }
template <class It> bool operator<=(const reverse_iterator<It>& a, const reverse_iterator<It>& b) { return !(b < a); }
template <class It> bool operator>=(const reverse_iterator<It>& a, const reverse_iterator<It>& b) { return !(a < b); }
template <class It> typename reverse_iterator<It>::difference_type operator-(const reverse_iterator<It>& a, const reverse_iterator<It>& b) { return b.base() - a.base(); }
template <class It> reverse_iterator<It> operator+(typename reverse_iterator<It>::difference_type n, const reverse_iterator<It>& a) { return a + n; }

}

#endif
