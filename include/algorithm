// algorithm - cppparse's C++98 library. The range algorithms take pointer iterators, which is
// what string and vector provide; map and set ranges are not sorted or searched this way.
#ifndef CPPPARSE_ALGORITHM
#define CPPPARSE_ALGORITHM

#include <cstddef>
#include <cstdlib>
#include <cstring>
#include <new>
#include <utility>

namespace std {

template <class T> const T& min(const T& a, const T& b) { return b < a ? b : a; }
template <class T> const T& max(const T& a, const T& b) { return a < b ? b : a; }
template <class T, class C> const T& min(const T& a, const T& b, C cmp) { return cmp(b, a) ? b : a; }
template <class T, class C> const T& max(const T& a, const T& b, C cmp) { return cmp(a, b) ? b : a; }

template <class T>
struct less {
    bool operator()(const T& a, const T& b) const { return a < b; }
};

template <class T>
struct greater {
    bool operator()(const T& a, const T& b) const { return b < a; }
};

template <class T>
struct equal_to {
    bool operator()(const T& a, const T& b) const { return a == b; }
};

template <class T>
void iter_swap(T* a, T* b)
{
    T t(*a);
    *a = *b;
    *b = t;
}

template <class T>
void reverse(T* first, T* last)
{
    while (first < last) {
        --last;
        iter_swap(first, last);
        ++first;
    }
}

template <class T, class V>
T* find(T* first, T* last, const V& value)
{
    for (; first != last; ++first) if (*first == value) return first;
    return last;
}

template <class T, class P>
T* find_if(T* first, T* last, P pred)
{
    for (; first != last; ++first) if (pred(*first)) return first;
    return last;
}

template <class T, class V>
size_t count(T* first, T* last, const V& value)
{
    size_t n = 0;
    for (; first != last; ++first) if (*first == value) ++n;
    return n;
}

template <class T, class U>
U* copy(const T* first, const T* last, U* out)
{
    for (; first != last; ++first, ++out) *out = *first;
    return out;
}

template <class T, class V>
void fill(T* first, T* last, const V& value)
{
    for (; first != last; ++first) *first = value;
}

template <class T, class V>
bool binary_search(const T* first, const T* last, const V& value)
{
    while (first < last) {
        const T* mid = first + (last - first) / 2;
        if (*mid < value) first = mid + 1;
        else if (value < *mid) last = mid;
        else return true;
    }
    return false;
}

template <class T, class V>
T* lower_bound(T* first, T* last, const V& value)
{
    while (first < last) {
        T* mid = first + (last - first) / 2;
        if (*mid < value) first = mid + 1; else last = mid;
    }
    return first;
}

template <class T, class V>
T* upper_bound(T* first, T* last, const V& value)
{
    while (first < last) {
        T* mid = first + (last - first) / 2;
        if (value < *mid) last = mid; else first = mid + 1;
    }
    return first;
}

template <class T>
T* unique(T* first, T* last)
{
    if (first == last) return last;
    T* out = first;
    for (++first; first != last; ++first)
        if (!(*out == *first)) { ++out; if (out != first) *out = *first; }
    return out + 1;
}

template <class T, class V>
T* remove(T* first, T* last, const V& value)
{
    T* out = first;
    for (; first != last; ++first)
        if (!(*first == value)) { if (out != first) *out = *first; ++out; }
    return out;
}

template <class T, class C>
void __insertion_sort(T* first, T* last, C cmp)
{
    for (T* i = first + 1; i < last; ++i) {
        T v(*i);
        T* j = i;
        while (j > first && cmp(v, *(j - 1))) { *j = *(j - 1); --j; }
        *j = v;
    }
}

template <class T, class C>
void __quick_sort(T* first, T* last, C cmp, int depth)
{
    while (last - first > 16) {
        if (depth == 0) {
            __insertion_sort(first, last, cmp);
            return;
        }
        --depth;
        T* mid = first + (last - first) / 2;
        if (cmp(*mid, *first)) iter_swap(mid, first);
        if (cmp(*(last - 1), *mid)) { iter_swap(last - 1, mid); if (cmp(*mid, *first)) iter_swap(mid, first); }
        T pivot(*mid);
        T* i = first;
        T* j = last - 1;
        for (;;) {
            while (cmp(*i, pivot)) ++i;
            while (cmp(pivot, *j)) --j;
            if (i >= j) break;
            iter_swap(i, j);
            ++i; --j;
        }
        __quick_sort(first, j + 1, cmp, depth);
        first = j + 1;
    }
    __insertion_sort(first, last, cmp);
}

template <class T, class C>
void sort(T* first, T* last, C cmp)
{
    int depth = 0;
    for (ptrdiff_t n = last - first; n > 1; n /= 2) depth += 2;
    __quick_sort(first, last, cmp, depth);
}

template <class T>
void sort(T* first, T* last)
{
    sort(first, last, less<T>());
}

template <class T, class C>
void __merge(T* first, T* mid, T* last, T* buffer, C cmp)
{
    T* a = first;
    T* b = mid;
    size_t n = 0;
    while (a < mid && b < last) {
        if (cmp(*b, *a)) { new (buffer + n) T(*b); ++b; }
        else { new (buffer + n) T(*a); ++a; }
        ++n;
    }
    while (a < mid) { new (buffer + n) T(*a); ++a; ++n; }
    while (b < last) { new (buffer + n) T(*b); ++b; ++n; }
    for (size_t i = 0; i < n; ++i) { first[i] = buffer[i]; buffer[i].~T(); }
}

template <class T, class C>
void __merge_sort(T* first, T* last, T* buffer, C cmp)
{
    if (last - first <= 16) { __insertion_sort(first, last, cmp); return; }
    T* mid = first + (last - first) / 2;
    __merge_sort(first, mid, buffer, cmp);
    __merge_sort(mid, last, buffer, cmp);
    __merge(first, mid, last, buffer, cmp);
}

template <class T, class C>
void stable_sort(T* first, T* last, C cmp)
{
    if (last - first <= 16) { __insertion_sort(first, last, cmp); return; }
    T* buffer = static_cast<T*>(malloc(sizeof(T) * static_cast<size_t>(last - first)));
    __merge_sort(first, last, buffer, cmp);
    free(buffer);
}

template <class T>
void stable_sort(T* first, T* last)
{
    stable_sort(first, last, less<T>());
}

}

#endif
