// clocale - cppparse's C++98 library: setlocale and localeconv of MSVC's C runtime, and Microsoft's locale objects
// (_locale_t, declared in <__config>), which <locale> makes its named locales of.
#ifndef CPPPARSE_CLOCALE
#define CPPPARSE_CLOCALE

#include <__config>

struct lconv {
    char* decimal_point;
    char* thousands_sep;
    char* grouping;
    char* int_curr_symbol;
    char* currency_symbol;
    char* mon_decimal_point;
    char* mon_thousands_sep;
    char* mon_grouping;
    char* positive_sign;
    char* negative_sign;
    char  int_frac_digits;
    char  frac_digits;
    char  p_cs_precedes;
    char  p_sep_by_space;
    char  n_cs_precedes;
    char  n_sep_by_space;
    char  p_sign_posn;
    char  n_sign_posn;
    wchar_t* _W_decimal_point;
    wchar_t* _W_thousands_sep;
    wchar_t* _W_int_curr_symbol;
    wchar_t* _W_currency_symbol;
    wchar_t* _W_mon_decimal_point;
    wchar_t* _W_mon_thousands_sep;
    wchar_t* _W_positive_sign;
    wchar_t* _W_negative_sign;
};

extern "C" {
    char*  setlocale(int category, const char* locale);
    lconv* localeconv(void);
    // Microsoft's: a locale object of a name (null for a name the C runtime does not know) and of the calling thread's
    // current locale, each freed with _free_locale; _configthreadlocale gives the calling thread a C locale of its own
    // (_ENABLE_PER_THREAD_LOCALE), which setlocale then changes, or the program's again, and returns the setting before
    _locale_t _create_locale(int category, const char* locale);
    _locale_t _get_current_locale(void);
    void      _free_locale(_locale_t locale);
    int       _configthreadlocale(int setting);
}

#define LC_ALL      0
#define LC_COLLATE  1
#define LC_CTYPE    2
#define LC_MONETARY 3
#define LC_NUMERIC  4
#define LC_TIME     5

#define _ENABLE_PER_THREAD_LOCALE  1
#define _DISABLE_PER_THREAD_LOCALE 2

namespace std {
    using ::lconv; using ::setlocale; using ::localeconv;
}

#endif
