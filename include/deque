// deque - cppparse's C++98 library: a double-ended queue (23.2.1) kept contiguous in a block from operator new with room
// at both ends, so that its iterators are pointers; growing at an end that is full reallocates (unlike the
// standard's deque, push_front and push_back invalidate the iterators and references then).
// The range constructor, assign and insert are member templates over any input iterator (23.2.1.1); two arguments of
// one integral type are a count and a value (23.1.1/9). A range of forward iterators is measured once and placed with
// at most one allocation (at the front without moving an element when there is room), an input range is read element
// by element (insert reads it into a deque of its own first).
#ifndef CPPPARSE_DEQUE
#define CPPPARSE_DEQUE

#include <cstddef>
#include <cstdlib>
#include <cstring>
#include <__iterator>
#include <new>
#include <__traits>

namespace std {

template <class T>
class deque {
public:
    typedef T         value_type;
    typedef size_t    size_type;
    typedef ptrdiff_t difference_type;
    typedef T*        iterator;
    typedef const T*  const_iterator;
    typedef T&        reference;
    typedef const T&  const_reference;
    typedef std::reverse_iterator<iterator>       reverse_iterator;
    typedef std::reverse_iterator<const_iterator> const_reverse_iterator;

    deque() : m_block(0), m_first(0), m_last(0), m_cap(0) {}
    explicit deque(size_t n) : m_block(0), m_first(0), m_last(0), m_cap(0) { resize(n); }
    deque(size_t n, const T& v) : m_block(0), m_first(0), m_last(0), m_cap(0) { assign(n, v); }
    // a range of any iterators, or "n copies of v" when both arguments are integers (a constructor that throws has
    // no destructor to clean up after it)
    template <class It> deque(It first, It last) : m_block(0), m_first(0), m_last(0), m_cap(0)
    {
        try { assignRange(first, last, static_cast<typename __range_category<It>::type*>(0)); } catch (...) { clear(); ::operator delete(m_block); throw; }
    }
    deque(const deque& o) : m_block(0), m_first(0), m_last(0), m_cap(0)
    {
        try { assignRange(o.begin(), o.end(), static_cast<forward_iterator_tag*>(0)); } catch (...) { clear(); ::operator delete(m_block); throw; }
    }
    ~deque() { clear(); ::operator delete(m_block); }
    deque& operator=(const deque& o) { if (this != &o) assignRange(o.begin(), o.end(), static_cast<forward_iterator_tag*>(0)); return *this; }

    iterator begin() { return m_block + m_first; }
    iterator end() { return m_block + m_last; }
    const_iterator begin() const { return m_block + m_first; }
    const_iterator end() const { return m_block + m_last; }
    reverse_iterator rbegin() { return reverse_iterator(end()); }
    reverse_iterator rend() { return reverse_iterator(begin()); }
    const_reverse_iterator rbegin() const { return const_reverse_iterator(end()); }
    const_reverse_iterator rend() const { return const_reverse_iterator(begin()); }

    size_t size() const { return m_last - m_first; }
    size_t max_size() const { return ~static_cast<size_t>(0) / sizeof(T); }
    bool   empty() const { return m_first == m_last; }
    T&       operator[](size_t i) { return m_block[m_first + i]; }
    const T& operator[](size_t i) const { return m_block[m_first + i]; }
    T&       at(size_t i) { return m_block[m_first + i]; }
    const T& at(size_t i) const { return m_block[m_first + i]; }
    T&       front() { return m_block[m_first]; }
    const T& front() const { return m_block[m_first]; }
    T&       back() { return m_block[m_last - 1]; }
    const T& back() const { return m_block[m_last - 1]; }

    void push_back(const T& v) { if (m_last == m_cap) makeRoom(1, false); new (m_block + m_last) T(v); ++m_last; }
    void push_front(const T& v) { if (m_first == 0) makeRoom(1, true); --m_first; new (m_block + m_first) T(v); }
    void pop_back() { --m_last; m_block[m_last].~T(); }
    void pop_front() { m_block[m_first].~T(); ++m_first; }
    void clear() { for (size_t i = m_first; i < m_last; ++i) m_block[i].~T(); m_first = m_last = m_cap / 2; }
    void resize(size_t n) { while (size() > n) pop_back(); while (size() < n) push_back(T()); }
    void resize(size_t n, const T& v) { while (size() > n) pop_back(); while (size() < n) push_back(v); }
    void assign(size_t n, const T& v) { clear(); for (size_t i = 0; i < n; ++i) push_back(v); }
    template <class It> void assign(It first, It last) { assignRange(first, last, static_cast<typename __range_category<It>::type*>(0)); }
    void swap(deque& o)
    {
        T* b = m_block; m_block = o.m_block; o.m_block = b;
        size_t t = m_first; m_first = o.m_first; o.m_first = t;
        t = m_last; m_last = o.m_last; o.m_last = t;
        t = m_cap; m_cap = o.m_cap; o.m_cap = t;
    }

    iterator insert(iterator pos, const T& v)
    {
        size_t at = pos - begin();
        push_back(v);                         // room, then the elements after at move up by one
        for (size_t i = size() - 1; i > at; --i) m_block[m_first + i] = m_block[m_first + i - 1];
        m_block[m_first + at] = v;
        return begin() + at;
    }
    void insert(iterator pos, size_t n, const T& v) { size_t at = pos - begin(); for (size_t k = 0; k < n; ++k) insert(begin() + at, v); }
    template <class It> void insert(iterator pos, It first, It last) { insertRange(pos, first, last, static_cast<typename __range_category<It>::type*>(0)); }
    iterator erase(iterator pos)
    {
        size_t at = pos - begin();
        for (size_t i = at; i + 1 < size(); ++i) m_block[m_first + i] = m_block[m_first + i + 1];
        pop_back();
        return begin() + at;
    }
    iterator erase(iterator first, iterator last)
    {
        size_t at = first - begin();
        size_t n = last - first;
        for (size_t i = at; i + n < size(); ++i) m_block[m_first + i] = m_block[m_first + i + n];
        while (n-- > 0) pop_back();
        return begin() + at;
    }

private:
    // The workers of the member templates, chosen by __range_category: two integers (a count and a value), a range
    // of forward iterators, a range of input iterators.
    template <class N> void assignRange(N n, N v, __true_type*) { assign(static_cast<size_t>(n), static_cast<T>(v)); }
    template <class It> void assignRange(It first, It last, forward_iterator_tag*)
    {
        size_t n = static_cast<size_t>(std::distance(first, last));
        clear();
        if (n > m_cap) makeRoom(n, false);
        else m_first = m_last = (m_cap - n) / 2;
        for (; first != last; ++first) { new (m_block + m_last) T(*first); ++m_last; }
    }
    template <class It> void assignRange(It first, It last, input_iterator_tag*) { clear(); for (; first != last; ++first) push_back(*first); }

    template <class N> void insertRange(iterator pos, N n, N v, __true_type*) { insert(pos, static_cast<size_t>(n), static_cast<T>(v)); }
    // the range is not of this deque's elements. At the front the new elements are built before the first one; elsewhere
    // room is made at the back and the elements after pos move up: what lands past the old end is copy-constructed, the
    // rest assigned
    template <class It> void insertRange(iterator pos, It first, It last, forward_iterator_tag*)
    {
        size_t at = static_cast<size_t>(pos - begin());
        size_t n = static_cast<size_t>(std::distance(first, last));
        if (n == 0) return;
        if (at == 0) {
            if (m_first < n) makeRoom(n, true);
            T* d = m_block + m_first - n;
            size_t k = 0;
            try { for (; k < n; ++k, ++first) new (d + k) T(*first); } catch (...) { while (k > 0) { --k; d[k].~T(); } throw; }
            m_first -= n;
            return;
        }
        if (m_cap - m_last < n) makeRoom(n, false);
        T* p = m_block + m_first;
        size_t old = size(), tail = old - at, i;
        if (n > tail) {
            It mid = first;
            std::advance(mid, static_cast<typename iterator_traits<It>::difference_type>(tail));
            for (It s = mid; s != last; ++s) { new (m_block + m_last) T(*s); ++m_last; }
            for (i = at; i < old; ++i) { new (m_block + m_last) T(p[i]); ++m_last; }
            for (i = 0; i < tail; ++i, ++first) p[at + i] = *first;
        } else {
            for (i = old - n; i < old; ++i) { new (m_block + m_last) T(p[i]); ++m_last; }
            for (i = old - n; i > at; --i) p[i + n - 1] = p[i - 1];
            for (i = 0; i < n; ++i, ++first) p[at + i] = *first;
        }
    }
    // the range can be read once only: into a deque of its own, which is then inserted
    template <class It> void insertRange(iterator pos, It first, It last, input_iterator_tag*)
    {
        size_t at = static_cast<size_t>(pos - begin());
        deque read;
        for (; first != last; ++first) read.push_back(*first);
        insertRange(begin() + at, read.begin(), read.end(), static_cast<forward_iterator_tag*>(0));
    }
    // a bigger block with the elements in its middle and room for extra more at the end named (the live objects are
    // moved by their copy constructors: all are copied before the first is destroyed, so a copy that throws leaves
    // the deque as it was)
    void makeRoom(size_t extra, bool atFront)
    {
        size_t n = size();
        size_t cap = m_cap ? m_cap * 2 + extra : 8 + extra;
        T* block = static_cast<T*>(::operator new(cap * sizeof(T)));
        size_t first = (cap - n) / 2;
        if (atFront && first < extra) first = extra;
        if (!atFront && cap - first - n < extra) first = cap - n - extra;
        size_t i = 0;
        try { for (; i < n; ++i) new (block + first + i) T(m_block[m_first + i]); }
        catch (...) { while (i > 0) { --i; block[first + i].~T(); } ::operator delete(block); throw; }
        for (i = 0; i < n; ++i) m_block[m_first + i].~T();
        ::operator delete(m_block);
        m_block = block; m_first = first; m_last = first + n; m_cap = cap;
    }
    T*     m_block;
    size_t m_first, m_last, m_cap;
};

template <class T> bool operator==(const deque<T>& a, const deque<T>& b)
{
    if (a.size() != b.size()) return false;
    for (size_t i = 0; i < a.size(); ++i) if (!(a[i] == b[i])) return false;
    return true;
}
template <class T> bool operator!=(const deque<T>& a, const deque<T>& b) { return !(a == b); }
template <class T> bool operator<(const deque<T>& a, const deque<T>& b)
{
    size_t n = a.size() < b.size() ? a.size() : b.size();
    for (size_t i = 0; i < n; ++i) { if (a[i] < b[i]) return true; if (b[i] < a[i]) return false; }
    return a.size() < b.size();
}
template <class T> void swap(deque<T>& a, deque<T>& b) { a.swap(b); }

}

#endif
