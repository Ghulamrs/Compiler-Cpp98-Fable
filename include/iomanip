// iomanip - cppparse's C++98 library: the parameterised manipulators (27.6.3): setw, setfill, setprecision,
// setbase, setiosflags and resetiosflags, as small objects the stream operators apply.
#ifndef CPPPARSE_IOMANIP
#define CPPPARSE_IOMANIP

#include <ios>
#include <istream>
#include <ostream>

namespace std {

struct __iomanip_width { streamsize n; };
struct __iomanip_fill { char c; };
struct __iomanip_precision { streamsize n; };
struct __iomanip_base { int base; };
struct __iomanip_setflags { ios_base::fmtflags f; };
struct __iomanip_resetflags { ios_base::fmtflags f; };

inline __iomanip_width setw(streamsize n) { __iomanip_width m; m.n = n; return m; }
inline __iomanip_fill setfill(char c) { __iomanip_fill m; m.c = c; return m; }
inline __iomanip_precision setprecision(streamsize n) { __iomanip_precision m; m.n = n; return m; }
inline __iomanip_base setbase(int base) { __iomanip_base m; m.base = base; return m; }
inline __iomanip_setflags setiosflags(ios_base::fmtflags f) { __iomanip_setflags m; m.f = f; return m; }
inline __iomanip_resetflags resetiosflags(ios_base::fmtflags f) { __iomanip_resetflags m; m.f = f; return m; }

inline void __apply_base(ios_base& b, int base) { b.setf(base == 16 ? ios_base::hex : base == 8 ? ios_base::oct : base == 10 ? ios_base::dec : 0, ios_base::basefield); }

inline ostream& operator<<(ostream& o, __iomanip_width m) { o.width(m.n); return o; }
inline ostream& operator<<(ostream& o, __iomanip_fill m) { o.fill(m.c); return o; }
inline ostream& operator<<(ostream& o, __iomanip_precision m) { o.precision(m.n); return o; }
inline ostream& operator<<(ostream& o, __iomanip_base m) { __apply_base(o, m.base); return o; }
inline ostream& operator<<(ostream& o, __iomanip_setflags m) { o.setf(m.f); return o; }
inline ostream& operator<<(ostream& o, __iomanip_resetflags m) { o.unsetf(m.f); return o; }

inline istream& operator>>(istream& i, __iomanip_width m) { i.width(m.n); return i; }
inline istream& operator>>(istream& i, __iomanip_fill m) { i.fill(m.c); return i; }
inline istream& operator>>(istream& i, __iomanip_precision m) { i.precision(m.n); return i; }
inline istream& operator>>(istream& i, __iomanip_base m) { __apply_base(i, m.base); return i; }
inline istream& operator>>(istream& i, __iomanip_setflags m) { i.setf(m.f); return i; }
inline istream& operator>>(istream& i, __iomanip_resetflags m) { i.unsetf(m.f); return i; }

}

#endif
