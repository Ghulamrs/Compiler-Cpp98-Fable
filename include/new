// new - cppparse's C++98 library: the global allocation functions, placement new, the nothrow forms, bad_alloc and
// set_new_handler. New- and delete-expressions call the global operators by their MSVC names without looking them up
// here; libcpp/iostream.cpp defines them (malloc; when it fails, the handler of set_new_handler is called and the
// allocation tried again, and without a handler bad_alloc is thrown through cppparse's runtime; the nothrow forms
// give null) and set_new_handler with them, so a program that calls set_new_handler links libcpp (LNK2019 otherwise).
// A program that does not link libcpp gets the C runtime's operators (whose failure is reported through MSVC's
// exception handling, which no cppparse frame can catch; its nothrow forms call its operator new). Either program may
// replace any of the eight replaceable ones (18.4.1.1/2) in a unit of its own: libcpp's are defaults
// (__declspec(replaceable)) that give way to the program's definitions when it is linked, and the ones it leaves call
// the ones it defines (the array and nothrow forms call the plain ones), as the C runtime's do. The placement forms
// are reserved (18.4.1.3) and inline.
#ifndef CPPPARSE_NEW
#define CPPPARSE_NEW

#include <cstddef>
#include <cstdlib>
#include <exception>

namespace std {

class bad_alloc : public exception {
public:
    bad_alloc() {}
    virtual ~bad_alloc() {}
    virtual const char* what() const { return "bad allocation"; }
};

struct nothrow_t {};
const nothrow_t nothrow = {};

typedef void (*new_handler)();
new_handler set_new_handler(new_handler new_p) throw();   // 18.4.2.3: returns the handler it replaces, null the first time

}

void* operator new(size_t) throw(std::bad_alloc);
void* operator new[](size_t) throw(std::bad_alloc);
void  operator delete(void*) throw();
void  operator delete[](void*) throw();
void* operator new(size_t, const std::nothrow_t&) throw();
void* operator new[](size_t, const std::nothrow_t&) throw();
void  operator delete(void*, const std::nothrow_t&) throw();
void  operator delete[](void*, const std::nothrow_t&) throw();
inline void* operator new(size_t, void* place) throw() { return place; }
inline void* operator new[](size_t, void* place) throw() { return place; }
inline void  operator delete(void*, void*) throw() {}
inline void  operator delete[](void*, void*) throw() {}

#endif
