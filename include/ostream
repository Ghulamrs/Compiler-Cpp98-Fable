// ostream - cppparse's C++98 library: formatted output. ostream formats into a virtual sink that
// the string and file streams supply. Numbers are formatted here without the C library, so no
// variadic call is needed.
#ifndef CPPPARSE_OSTREAM
#define CPPPARSE_OSTREAM

#include <cstddef>
#include <cstring>
#include <ios>
#include <string>

namespace std {

// the exact decimal expansion of a finite double >= 0, one digit at a time: first the digits of the integer
// part, then those of the fraction, kept as the binary fraction num / 2^bits and multiplied by ten per digit
struct __decimal_digits {
    char         intDigits[320];   // most significant first, no leading zeros
    int          intCount;
    int          used;             // integer digits handed out so far
    unsigned int num[36];          // 32-bit limbs, least significant first
    int          bits;

    explicit __decimal_digits(double v) : intCount(0), used(0), bits(0)
    {
        unsigned long long raw;
        memcpy(&raw, &v, sizeof raw);
        const unsigned long long one = 1;
        int biased = static_cast<int>((raw >> 52) & 0x7FF);
        unsigned long long mant = raw & ((one << 52) - 1);
        if (biased != 0) mant |= one << 52;
        int e = biased != 0 ? biased - 1075 : -1074;
        for (int i = 0; i < 36; ++i) num[i] = 0;
        if (mant == 0) return;
        if (e >= 0) { shiftedWhole(mant, e); return; }
        bits = -e;
        unsigned long long whole = bits < 64 ? mant >> bits : 0;
        unsigned long long frac = bits < 64 ? mant & ((one << bits) - 1) : mant;
        num[0] = static_cast<unsigned int>(frac);
        num[1] = static_cast<unsigned int>(frac >> 32);
        char tmp[24];
        int k = 0;
        while (whole > 0) { tmp[k++] = static_cast<char>('0' + whole % 10); whole /= 10; }
        while (k > 0) intDigits[intCount++] = tmp[--k];
    }
    // mant * 2^e in base 10^9 limbs, then printed
    void shiftedWhole(unsigned long long mant, int e)
    {
        unsigned int limb[40];
        int n = 0;
        while (mant > 0) { limb[n++] = static_cast<unsigned int>(mant % 1000000000); mant /= 1000000000; }
        for (int s = 0; s < e; ++s) {
            unsigned int carry = 0;
            for (int i = 0; i < n; ++i) { unsigned int t = limb[i] * 2 + carry; carry = t >= 1000000000 ? 1 : 0; limb[i] = t - carry * 1000000000; }
            if (carry) limb[n++] = 1;
        }
        char tmp[16];
        int k = 0;
        unsigned int top = limb[n - 1];
        while (top > 0) { tmp[k++] = static_cast<char>('0' + top % 10); top /= 10; }
        while (k > 0) intDigits[intCount++] = tmp[--k];
        for (int i = n - 2; i >= 0; --i) {
            unsigned int x = limb[i];
            for (int d = 8; d >= 0; --d) { intDigits[intCount + d] = static_cast<char>('0' + x % 10); x /= 10; }
            intCount += 9;
        }
    }
    int fractionDigit()
    {
        if (bits == 0) return 0;
        const int limb = bits / 32, shift = bits % 32;
        unsigned long long carry = 0;
        for (int i = 0; i <= limb + 1; ++i) { unsigned long long t = static_cast<unsigned long long>(num[i]) * 10 + carry; num[i] = static_cast<unsigned int>(t); carry = t >> 32; }
        unsigned long long high = num[limb] | (static_cast<unsigned long long>(num[limb + 1]) << 32);
        int d = static_cast<int>((high >> shift) & 15);
        num[limb] &= shift ? (static_cast<unsigned int>(1) << shift) - 1 : 0;
        num[limb + 1] = 0;
        return d;
    }
    int digit() { return used < intCount ? intDigits[used++] - '0' : fractionDigit(); }
    bool restIsZero() const
    {
        for (int i = used; i < intCount; ++i) if (intDigits[i] != '0') return false;
        for (int i = 0; i < 36; ++i) if (num[i]) return false;
        return true;
    }
    // whether the digits not taken yet round the last taken one up; an exact half rounds to even, as printf does
    bool roundsUp(int lastDigit)
    {
        int d = digit();
        if (d != 5) return d > 5;
        return !restIsZero() || (lastDigit & 1) != 0;
    }
};

class ostream : public ios {
public:
    ostream() {}
    virtual ~ostream() {}

    ostream& put(char c) { return write(&c, 1); }
    ostream& write(const char* s, streamsize n) { if (good()) { flushTie(); sink(s, static_cast<size_t>(n)); } return *this; }
    ostream& flush() { sync(); return *this; }

    ostream& operator<<(const char* s) { return padded(s, strlen(s)); }
    ostream& operator<<(char c) { return padded(&c, 1); }
    ostream& operator<<(signed char c) { char ch = static_cast<char>(c); return padded(&ch, 1); }
    ostream& operator<<(unsigned char c) { char ch = static_cast<char>(c); return padded(&ch, 1); }
    ostream& operator<<(bool v)
    {
        if (m_flags & boolalpha) return v ? padded("true", 4) : padded("false", 5);
        return unsignedNumber(v ? 1 : 0, false);
    }
    ostream& operator<<(short v) { return signedNumber(v); }
    ostream& operator<<(unsigned short v) { return unsignedNumber(v, false); }
    ostream& operator<<(int v) { return signedNumber(v); }
    ostream& operator<<(unsigned v) { return unsignedNumber(v, false); }
    ostream& operator<<(long v) { return signedNumber(v); }
    ostream& operator<<(unsigned long v) { return unsignedNumber(v, false); }
    ostream& operator<<(long long v) { return signedNumber(v); }
    ostream& operator<<(unsigned long long v) { return unsignedNumber(v, false); }
    ostream& operator<<(float v) { return floating(v); }
    ostream& operator<<(double v) { return floating(v); }
    ostream& operator<<(long double v) { return floating(static_cast<double>(v)); }
    ostream& operator<<(const void* p)
    {
        char buf[16];
        unsigned long long u = reinterpret_cast<unsigned long long>(p);
        for (int i = 15; i >= 0; --i) { int d = static_cast<int>(u & 15); buf[i] = static_cast<char>(d < 10 ? '0' + d : 'A' + d - 10); u >>= 4; }
        return padded(buf, 16);
    }
    ostream& operator<<(const string& s) { return padded(s.data(), s.size()); }
    ostream& operator<<(ostream& (*fn)(ostream&)) { return fn(*this); }
    ostream& operator<<(ios_base& (*fn)(ios_base&)) { fn(*this); return *this; }
    ostream& operator<<(streambuf* sb);     // defined in <istream>: copies the rest of that stream's input

protected:
    virtual void sink(const char* s, size_t n) = 0;
    virtual void sync() {}

    void flushTie() { if (m_tie) m_tie->flush(); }   // the stream tied to this one (cout to cerr) is flushed first
    ostream& padded(const char* s, size_t n)
    {
        if (!good()) return *this;
        flushTie();
        size_t w = m_width > 0 ? static_cast<size_t>(m_width) : 0;
        m_width = 0;
        bool leftAdjusted = (m_flags & left) != 0;
        if (w > n && !leftAdjusted) fillChars(w - n);
        sink(s, n);
        if (w > n && leftAdjusted) fillChars(w - n);
        return *this;
    }
    void fillChars(size_t n)
    {
        char buf[32];
        memset(buf, m_fill, 32);
        while (n > 0) { size_t k = n < 32 ? n : 32; sink(buf, k); n -= k; }
    }
    ostream& signedNumber(long long v)
    {
        if (v < 0) return unsignedNumber(static_cast<unsigned long long>(-(v + 1)) + 1, true);
        return unsignedNumber(static_cast<unsigned long long>(v), false);
    }
    ostream& unsignedNumber(unsigned long long u, bool negative)
    {
        char buf[72];
        size_t i = 72;
        unsigned base = (m_flags & hex) ? 16 : (m_flags & oct) ? 8 : 10;
        bool upper = (m_flags & uppercase) != 0;
        if (u == 0) buf[--i] = '0';
        while (u > 0) {
            unsigned d = static_cast<unsigned>(u % base);
            buf[--i] = static_cast<char>(d < 10 ? '0' + d : (upper ? 'A' : 'a') + d - 10);
            u /= base;
        }
        if (m_flags & showbase) { if (base == 16) { buf[--i] = upper ? 'X' : 'x'; buf[--i] = '0'; } else if (base == 8) buf[--i] = '0'; }
        if (negative) buf[--i] = '-';
        else if (m_flags & showpos) buf[--i] = '+';
        return padded(buf + i, 72 - i);
    }
    ostream& floating(double v)
    {
        char buf[400];
        size_t n = formatDouble(v, buf);
        return padded(buf, n);
    }
    static void digits(unsigned long long u, char* out, size_t& n)
    {
        char tmp[24];
        size_t k = 0;
        if (u == 0) tmp[k++] = '0';
        while (u > 0) { tmp[k++] = static_cast<char>('0' + u % 10); u /= 10; }
        while (k > 0) out[n++] = tmp[--k];
    }
    // ++ on a digit string; false when it carried out of the first digit (all digits are then '0')
    static bool roundDigitsUp(char* d, int digitCount)
    {
        int i = digitCount - 1;
        while (i >= 0 && d[i] == '9') { d[i] = '0'; --i; }
        if (i < 0) return false;
        ++d[i];
        return true;
    }
    // fixed notation with p digits after the point, correctly rounded; the integer part has at most 19 digits.
    // The point is written when digits follow it or showpoint asks for it
    static void fixedDigits(double v, int p, bool point, char* out, size_t& n)
    {
        __decimal_digits g(v);
        char d[340];
        int whole = g.intCount, digitCount = 0;
        while (digitCount < whole + p) d[digitCount++] = static_cast<char>('0' + g.digit());
        if (g.roundsUp(digitCount > 0 ? d[digitCount - 1] - '0' : 0) && !roundDigitsUp(d, digitCount)) {
            for (int k = digitCount; k > 0; --k) d[k] = d[k - 1];
            d[0] = '1';
            ++digitCount;
            ++whole;
        }
        if (whole == 0) out[n++] = '0';
        for (int i = 0; i < whole; ++i) out[n++] = d[i];
        if (p > 0 || point) out[n++] = '.';
        for (int i = whole; i < digitCount; ++i) out[n++] = d[i];
    }
    // scientific notation with p digits after the point, correctly rounded; returns the exponent
    static int scientificDigits(double v, int p, bool point, char* out, size_t& n, bool upper)
    {
        __decimal_digits g(v);
        char d[340];
        int e = 0;
        int first = g.digit();
        if (g.intCount > 0) e = g.intCount - 1;
        else if (v > 0) { e = -1; while (first == 0) { first = g.digit(); --e; } }
        d[0] = static_cast<char>('0' + first);
        int digitCount = 1;
        while (digitCount < p + 1) d[digitCount++] = static_cast<char>('0' + g.digit());
        if (g.roundsUp(d[digitCount - 1] - '0') && !roundDigitsUp(d, digitCount)) { d[0] = '1'; ++e; }
        out[n++] = d[0];
        if (p > 0 || point) out[n++] = '.';
        for (int i = 1; i < digitCount; ++i) out[n++] = d[i];
        const int exponent = e;
        out[n++] = upper ? 'E' : 'e';
        out[n++] = e < 0 ? '-' : '+';
        if (e < 0) e = -e;
        if (e < 10) out[n++] = '0';
        digits(static_cast<unsigned long long>(e), out, n);
        return exponent;
    }
    static void stripZeros(char* out, size_t& n, size_t from)
    {
        // general notation: trailing zeros of the fraction and a bare point go
        size_t end = n;
        size_t expAt = n;
        for (size_t i = from; i < n; ++i) if (out[i] == 'e' || out[i] == 'E') { expAt = i; break; }
        bool hasPoint = false;
        for (size_t i = from; i < expAt; ++i) if (out[i] == '.') hasPoint = true;
        if (!hasPoint) return;
        size_t cut = expAt;
        while (cut > from && out[cut - 1] == '0') --cut;
        if (cut > from && out[cut - 1] == '.') --cut;
        if (cut < expAt) { for (size_t i = expAt; i < end; ++i) out[cut + i - expAt] = out[i]; n = cut + (end - expAt); }
    }
    size_t formatDouble(double v, char* out)
    {
        size_t n = 0;
        if (v != v) { out[n++] = 'n'; out[n++] = 'a'; out[n++] = 'n'; return n; }
        if (v < 0 || (v == 0 && 1 / v < 0)) { out[n++] = '-'; v = -v; }   // -0 keeps its sign, as cl prints it
        else if (m_flags & showpos) out[n++] = '+';
        if (v > 1.7976931348623157e308) { out[n++] = 'i'; out[n++] = 'n'; out[n++] = 'f'; return n; }
        int p = static_cast<int>(m_precision);
        if (p < 0) p = 6;
        if (p > 300) p = 300;
        bool upper = (m_flags & uppercase) != 0;
        bool point = (m_flags & showpoint) != 0;
        size_t from = n;
        if ((m_flags & floatfield) == fixed) { if (v < 1e19) fixedDigits(v, p, point, out, n); else scientificDigits(v, p, point, out, n, upper); return n; }
        if ((m_flags & floatfield) == scientific) { scientificDigits(v, p, point, out, n, upper); return n; }
        if (p == 0) p = 1;
        // the exponent that decides between the notations is that of the value rounded to p digits
        char sci[340];
        size_t sn = 0;
        int e = scientificDigits(v, p - 1, point, sci, sn, upper);
        if (e < -4 || e >= p) { memcpy(out + n, sci, sn); n += sn; }
        else fixedDigits(v, p - 1 - e, point, out, n);
        if (!(m_flags & showpoint)) stripZeros(out, n, from);
        return n;
    }
};

inline ostream& endl(ostream& o) { o.put('\n'); return o.flush(); }
inline ostream& ends(ostream& o) { return o.put('\0'); }
inline ostream& flush(ostream& o) { return o.flush(); }
inline ios_base& fixed(ios_base& b) { b.setf(ios_base::fixed, ios_base::floatfield); return b; }
inline ios_base& scientific(ios_base& b) { b.setf(ios_base::scientific, ios_base::floatfield); return b; }
inline ios_base& hex(ios_base& b) { b.setf(ios_base::hex, ios_base::basefield); return b; }
inline ios_base& dec(ios_base& b) { b.setf(ios_base::dec, ios_base::basefield); return b; }
inline ios_base& oct(ios_base& b) { b.setf(ios_base::oct, ios_base::basefield); return b; }
inline ios_base& left(ios_base& b) { b.setf(ios_base::left, ios_base::adjustfield); return b; }
inline ios_base& right(ios_base& b) { b.setf(ios_base::right, ios_base::adjustfield); return b; }
inline ios_base& boolalpha(ios_base& b) { b.setf(ios_base::boolalpha); return b; }

}

#endif
